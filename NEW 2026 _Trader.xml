
export type DerivMarket = {
    label: string;
    market: string;
    submarket: string;
    symbol: string;
};

export const DERIV_MARKETS: DerivMarket[] = [
    { label: "Volatility 10", market: "synthetic_index", submarket: "random_index", symbol: "R_10" },
    { label: "Volatility 25", market: "synthetic_index", submarket: "random_index", symbol: "R_25" },
    { label: "Volatility 50", market: "synthetic_index", submarket: "random_index", symbol: "R_50" },
    { label: "Volatility 75", market: "synthetic_index", submarket: "random_index", symbol: "R_75" },
    { label: "Volatility 100", market: "synthetic_index", submarket: "random_index", symbol: "R_100" },
    { label: "Volatility 10 (1s)", market: "synthetic_index", submarket: "random_index", symbol: "1HZ10V" },
    { label: "Volatility 25 (1s)", market: "synthetic_index", submarket: "random_index", symbol: "1HZ25V" },
    { label: "Volatility 50 (1s)", market: "synthetic_index", submarket: "random_index", symbol: "1HZ50V" },
    { label: "Volatility 75 (1s)", market: "synthetic_index", submarket: "random_index", symbol: "1HZ75V" },
    { label: "Volatility 100 (1s)", market: "synthetic_index", submarket: "random_index", symbol: "1HZ100V" },
    { label: "Jump 10", market: "synthetic_index", submarket: "jump_index", symbol: "JD10" },
    { label: "Jump 25", market: "synthetic_index", submarket: "jump_index", symbol: "JD25" },
    { label: "Jump 50", market: "synthetic_index", submarket: "jump_index", symbol: "JD50" },
    { label: "Jump 75", market: "synthetic_index", submarket: "jump_index", symbol: "JD75" },
    { label: "Jump 100", market: "synthetic_index", submarket: "jump_index", symbol: "JD100" },
];

export const DEFAULT_MARKET = "1HZ75V";

export type BotSettings = {
    market?: string;
    ticks?: number;
    initialStake?: number;
    takeProfit?: number;
    stopLoss?: number;
    maxConsecutiveLosses?: number;
    maxStake?: number;
};

const escapeXml = (value: string): string =>
    value.replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&apos;");

function numberField(name: string, value: number): string {
    return `<field name="${name}">${value}</field>`;
}

export function buildOverUnderFrequencyXml(
    settings: BotSettings = {}
): string {
    const market = DERIV_MARKETS.find(
        item => item.symbol === (settings.market ?? DEFAULT_MARKET)
    );

    if (!market) {
        throw new Error(`Unsupported market: ${settings.market}`);
    }

    const ticks = settings.ticks ?? 1000;
    const initialStake = settings.initialStake ?? 0.35;
    const takeProfit = settings.takeProfit ?? 1.5;
    const stopLoss = settings.stopLoss ?? 3;
    const maxLosses = settings.maxConsecutiveLosses ?? 3;
    const maxStake = settings.maxStake ?? 1;

    if (!Number.isInteger(ticks) || ticks < 10 || ticks > 10000) {
        throw new Error("ticks must be an integer between 10 and 10000");
    }

    if (!Number.isFinite(initialStake) || initialStake <= 0) {
        throw new Error("initialStake must be greater than zero");
    }

    if (!Number.isFinite(takeProfit) || takeProfit <= 0) {
        throw new Error("takeProfit must be greater than zero");
    }

    if (!Number.isFinite(stopLoss) || stopLoss <= 0) {
        throw new Error("stopLoss must be greater than zero");
    }

    if (!Number.isInteger(maxLosses) || maxLosses < 1 || maxLosses > 20) {
        throw new Error("maxConsecutiveLosses must be between 1 and 20");
    }

    if (!Number.isFinite(maxStake) || maxStake < initialStake) {
        throw new Error("maxStake must be at least initialStake");
    }

    const variables: [string, string][] = [
        ["ouf_ticks", "Ticks"],
        ["ouf_runs", "Runs"],
        ["ouf_left", "Runs Left"],
        ["ouf_dominant", "Most Frequent"],
        ["ouf_entry", "Entry Point"],
        ["ouf_entered", "Entry Used"],
        ["ouf_prediction", "Active Prediction"],
        ["ouf_initial", "Initial Stake"],
        ["ouf_stake", "Stake"],
        ["ouf_lost", "Amount Lost"],
        ["ouf_payout", "Payout Percent"],
        ["ouf_loss_count", "Loss Counter"],
        ["ouf_max_losses", "Max Consecutive Losses"],
        ["ouf_take_profit", "Take Profit"],
        ["ouf_stop_loss", "Stop Loss"],
        ["ouf_max_stake", "Maximum Stake"],
        ["ouf_total", "Total Profit"],
        ["ouf_profit", "Last Profit"],
        ["ouf_stopped", "Session Stopped"],
    ];

    const variableXml = variables.map(
        ([id, name]) =>
            `<variable id="${id}">${escapeXml(name)}</variable>`
    ).join("\n");

    /*
     * These custom blocks must be implemented and registered in the
     * target Blockly application. XML cannot install their runtime logic.
     */
    const customScanner = `
      <block type="over_under_frequency_scan">
        <value name="N">
          <block type="math_number">
            ${numberField("NUM", ticks)}
          </block>
        </value>
      </block>`;

    const customEntry =
        `<block type="over_under_frequency_entry"></block>`;

    const customDominant =
        `<block type="over_under_frequency_dominant"></block>`;

    /*
     * A safe template and explicit stop flag are included.
     * The scanner's return values and the entry strategy must be
     * implemented by the target application before execution.
     */
    return `<xml xmlns="https://developers.google.com/blockly/xml"
        is_dbot="true" collection="false">
      <variables>
        ${variableXml}
      </variables>

      <block type="trade_definition" id="ouf_trade_def"
          deletable="false" x="0" y="0">
        <statement name="TRADE_OPTIONS">
          <block type="trade_definition_market" id="ouf_market">
            ${numberField("MARKET_LIST", 0).replace(
                /<field name="MARKET_LIST">0<\\/field>/,
                `<field name="MARKET_LIST">${escapeXml(market.market)}</field>`
            )}
            <field name="SUBMARKET_LIST">${escapeXml(market.submarket)}</field>
            <field name="SYMBOL_LIST">${escapeXml(market.symbol)}</field>
            <next>
              <block type="trade_definition_tradetype">
                <field name="TRADETYPECAT_LIST">digits</field>
                <field name="TRADETYPE_LIST">overunder</field>
                <next>
                  <block type="trade_definition_contracttype">
                    <field name="TYPE_LIST">both</field>
                    <next>
                      <block type="trade_definition_candleinterval">
                        <field name="CANDLEINTERVAL_LIST">60</field>
                        <next>
                          <block type="trade_definition_restartbuysell">
                            <field name="TIME_MACHINE_ENABLED">FALSE</field>
                            <next>
                              <block type="trade_definition_restartonerror">
                                <field name="RESTARTONERROR">FALSE</field>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>

        <statement name="INITIALIZATION">
          <block type="variables_set">
            <field name="VAR" id="ouf_ticks">Ticks</field>
            <value name="VALUE">
              <block type="math_number">${numberField("NUM", ticks)}</block>
            </value>
            <next>
              <block type="variables_set">
                <field name="VAR" id="ouf_initial">Initial Stake</field>
                <value name="VALUE">
                  <block type="math_number">${numberField("NUM", initialStake)}</block>
                </value>
                <next>
                  <block type="variables_set">
                    <field name="VAR" id="ouf_stake">Stake</field>
                    <value name="VALUE">
                      <block type="variables_get">
                        <field name="VAR" id="ouf_initial">Initial Stake</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set">
                        <field name="VAR" id="ouf_loss_count">Loss Counter</field>
                        <value name="VALUE">
                          <block type="math_number">${numberField("NUM", 0)}</block>
                        </value>
                        <next>
                          <block type="variables_set">
                            <field name="VAR" id="ouf_stopped">Session Stopped</field>
                            <value name="VALUE">
                              <block type="math_number">${numberField("NUM", 0)}</block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>

        <statement name="SUBMARKET">
          <block type="trade_definition_tradeoptions" id="ouf_tradeopts">
            <mutation has_first_barrier="false"
                has_second_barrier="false" has_prediction="true"></mutation>
            <field name="DURATIONTYPE_LIST">t</field>
            <value name="DURATION">
              <block type="math_number">${numberField("NUM", 1)}</block>
            </value>
            <value name="AMOUNT">
              <block type="variables_get">
                <field name="VAR" id="ouf_stake">Stake</field>
              </block>
            </value>
            <value name="PREDICTION">
              ${customDominant}
            </value>
          </block>
        </statement>
      </block>

      <block type="before_purchase" id="ouf_before" x="0" y="700">
        <statement name="BEFOREPURCHASE_STACK">
          <block type="controls_if">
            <value name="IF0">
              <block type="logic_compare">
                <field name="OP">EQ</field>
                <value name="A">
                  <block type="variables_get">
                    <field name="VAR" id="ouf_stopped">Session Stopped</field>
                  </block>
                </value>
                <value name="B">
                  <block type="math_number">${numberField("NUM", 0)}</block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              ${customScanner}
            </statement>
          </block>
        </statement>
      </block>

      <block type="after_purchase" id="ouf_after" x="900" y="0">
        <statement name="AFTERPURCHASE_STACK">
          <block type="variables_set">
            <field name="VAR" id="ouf_profit">Last Profit</field>
            <value name="VALUE">
              <block type="read_details">
                <field name="DETAIL_INDEX">4</field>
              </block>
            </value>
            <next>
              <block type="controls_if">
                <mutation else="1"></mutation>
                <value name="IF0">
                  <block type="contract_check_result">
                    <field name="CHECK_RESULT">win</field>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="variables_set">
                    <field name="VAR" id="ouf_loss_count">Loss Counter</field>
                    <value name="VALUE">
                      <block type="math_number">${numberField("NUM", 0)}</block>
                    </value>
                    <next>
                      <block type="variables_set">
                        <field name="VAR" id="ouf_stake">Stake</field>
                        <value name="VALUE">
                          <block type="variables_get">
                            <field name="VAR" id="ouf_initial">Initial Stake</field>
                          </block>
                        </value>
                      </block>
                    </next>
                  </block>
                </statement>
                <statement name="ELSE">
                  <block type="math_change">
                    <field name="VAR" id="ouf_loss_count">Loss Counter</field>
                    <value name="DELTA">
                      <block type="math_number">${numberField("NUM", 1)}</block>
                    </value>
                    <next>
                      <block type="controls_if">
                        <value name="IF0">
                          <block type="logic_compare">
                            <field name="OP">GTE</field>
                            <value name="A">
                              <block type="variables_get">
                                <field name="VAR" id="ouf_loss_count">Loss Counter</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_number">${numberField("NUM", maxLosses)}</block>
                            </value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="variables_set">
                            <field name="VAR" id="ouf_stopped">Session Stopped</field>
                            <value name="VALUE">
                              <block type="math_number">${numberField("NUM", 1)}</block>
                            </value>
                          </block>
                        </statement>
                      </block>
                    </next>
                  </block>
                </statement>
                <next>
                  <block type="controls_if">
                    <value name="IF0">
                      <block type="logic_compare">
                        <field name="OP">EQ</field>
                        <value name="A">
                          <block type="variables_get">
                            <field name="VAR" id="ouf_stopped">Session Stopped</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number">${numberField("NUM", 0)}</block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="trade_again"></block>
                    </statement>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </xml>`;
}

export const OVER_UNDER_FREQUENCY_XML =
    buildOverUnderFrequencyXml();

export function getMarketOptions(): {
    label: string;
    value: string;
}[] {
    return DERIV_MARKETS.map(({ label, symbol }) => ({
        label,
        value: symbol,
    }));
}
