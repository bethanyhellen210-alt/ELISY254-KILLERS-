
<xml xmlns="https://developers.google.com/blockly/xml" collection="false">
  <variables>
    <variable id="Stake">Stake</variable>
    <variable id="InitialStake">Initial Stake</variable>
    <variable id="TotalProfit">Total Profit</variable>
    <variable id="TargetProfit">Target Profit</variable>
    <variable id="StopLoss">Stop Loss</variable>
  </variables>

  <block type="trade_definition" id="trade_def" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="market_def">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ10V</field>
        <next>
          <block type="trade_definition_tradetype" id="type_def">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next>
              <block type="trade_definition_contracttype" id="contract_def">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_restartbuysell" id="restart_def">
                    <field name="TIME_MACHINE_ENABLED">FALSE</field>
                    <next>
                      <block type="trade_definition_restartonerror" id="error_def">
                        <field name="RESTARTONERROR">TRUE</field>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <statement name="INITIALIZATION">
      <block type="notify" id="start_notify">
        <field name="NOTIFICATION_TYPE">info</field>
        <field name="NOTIFICATION_SOUND">announcement</field>
        <value name="MESSAGE">
          <block type="text">
            <field name="TEXT">ELISY254 OVER/UNDER BOT STARTED</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="stake_init">
            <field name="VAR" id="Stake">Stake</field>
            <value name="VALUE">
              <block type="math_number">
                <field name="NUM">1</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="initial_init">
                <field name="VAR" id="InitialStake">Initial Stake</field>
                <value name="VALUE">
                  <block type="variables_get">
                    <field name="VAR" id="Stake">Stake</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="profit_init">
                    <field name="VAR" id="TotalProfit">Total Profit</field>
                    <value name="VALUE">
                      <block type="math_number">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="target_init">
                        <field name="VAR" id="TargetProfit">Target Profit</field>
                        <value name="VALUE">
                          <block type="math_number">
                            <field name="NUM">10</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="stop_init">
                            <field name="VAR" id="StopLoss">Stop Loss</field>
                            <value name="VALUE">
                              <block type="math_number">
                                <field name="NUM">50</field>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="options_def">
        <mutation has_first_barrier="true" has_second_barrier="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <block type="math_number">
            <field name="NUM">1</field>
          </block>
        </value>
        <value name="AMOUNT">
          <block type="variables_get">
            <field name="VAR" id="Stake">Stake</field>
          </block>
        </value>
        <value name="BARRIER">
          <block type="math_number">
            <field name="NUM">5</field>
          </block>
        </value>
      </block>
    </statement>
  </block>

  <block type="before_purchase" id="before_purchase_def" x="520" y="0">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="automatic_over_under">
        <mutation elseif="1" else="0"></mutation>
        <value name="IF0">
          <block type="logic_compare">
            <field name="OP">LT</field>
            <value name="A">
              <block type="last_digit"></block>
            </value>
            <value name="B">
              <block type="math_number">
                <field name="NUM">5</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="purchase" id="buy_under">
            <field name="PURCHASE_LIST">DIGITUNDER</field>
          </block>
        </statement>
        <value name="IF1">
          <block type="logic_compare">
            <field name="OP">GT</field>
            <value name="A">
              <block type="last_digit"></block>
            </value>
            <value name="B">
              <block type="math_number">
                <field name="NUM">5</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO1">
          <block type="purchase" id="buy_over">
            <field name="PURCHASE_LIST">DIGITOVER</field>
          </block>
        </statement>
      </block>
    </statement>
  </block>

  <block type="after_purchase" id="after_purchase_def" x="520" y="360">
    <statement name="AFTERPURCHASE_STACK">
      <block type="variables_set" id="profit_update">
        <field name="VAR" id="TotalProfit">Total Profit</field>
        <value name="VALUE">
          <block type="math_arithmetic">
            <field name="OP">ADD</field>
            <value name="A">
              <block type="variables_get">
                <field name="VAR" id="TotalProfit">Total Profit</field>
              </block>
            </value>
            <value name="B">
              <block type="read_details">
                <field name="DETAIL_INDEX">4</field>
              </block>
            </value>
          </block>
        </value>
        <next>
          <block type="controls_if" id="result_check">
            <mutation else="1"></mutation>
            <value name="IF0">
              <block type="contract_check_result">
                <field name="CHECK_RESULT">win</field>
              </block>
            </value>
            <statement name="DO0">
              <block type="notify">
                <field name="NOTIFICATION_TYPE">success</field>
                <field name="NOTIFICATION_SOUND">earned-money</field>
                <value name="MESSAGE">
                  <block type="text">
                    <field name="TEXT">ELISY254 WIN! Stake reset.</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set">
                    <field name="VAR" id="Stake">Stake</field>
                    <value name="VALUE">
                      <block type="variables_get">
                        <field name="VAR" id="InitialStake">Initial Stake</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="notify">
                <field name="NOTIFICATION_TYPE">error</field>
                <field name="NOTIFICATION_SOUND">severe-error</field>
                <value name="MESSAGE">
                  <block type="text">
                    <field name="TEXT">ELISY254 LOSS</field>
                  </block>
                </value>
              </block>
            </statement>
            <next>
              <block type="controls_if" id="limits_check">
                <mutation elseif="1" else="1"></mutation>
                <value name="IF0">
                  <block type="logic_compare">
                    <field name="OP">GTE</field>
                    <value name="A">
                      <block type="variables_get">
                        <field name="VAR" id="TotalProfit">Total Profit</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="variables_get">
                        <field name="VAR" id="TargetProfit">Target Profit</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="notify">
                    <field name="NOTIFICATION_TYPE">success</field>
                    <field name="NOTIFICATION_SOUND">job-done</field>
                    <value name="MESSAGE">
                      <block type="text">
                        <field name="TEXT">ELISY254 TARGET HIT!</field>
                      </block>
                    </value>
                  </block>
                </statement>
                <value name="IF1">
                  <block type="logic_compare">
                    <field name="OP">LTE</field>
                    <value name="A">
                      <block type="variables_get">
                        <field name="VAR" id="TotalProfit">Total Profit</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_single">
                        <field name="OP">NEG</field>
                        <value name="NUM">
                          <block type="variables_get">
                            <field name="VAR" id="StopLoss">Stop Loss</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO1">
                  <block type="notify">
                    <field name="NOTIFICATION_TYPE">error</field>
                    <field name="NOTIFICATION_SOUND">severe-error</field>
                    <value name="MESSAGE">
                      <block type="text">
                        <field name="TEXT">ELISY254 STOP LOSS HIT!</field>
                      </block>
                    </value>
                  </block>
                </statement>
                <statement name="ELSE">
                  <block type="trade_again"></block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
