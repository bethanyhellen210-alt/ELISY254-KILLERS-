
<xml xmlns="https://developers.google.com/blockly/xml" collection="false">
  <variables>
    <variable id="Stake">Stake</variable>
    <variable id="InitialStake">Initial Stake</variable>
    <variable id="Martingale">Martingale Reduction</variable>
    <variable id="TargetProfit">Target Profit</variable>
    <variable id="StopLoss">Stop Loss</variable>
    <variable id="TotalProfit">Total Profit</variable>
  </variables>

  <block type="trade_definition" id="trade_def" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="market_def">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ10V</field>
        <next>
          <block type="trade_definition_tradetype" id="tradetype_def">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">matchdiff</field>
            <next>
              <block type="trade_definition_contracttype" id="contracttype_def">
                <field name="TYPE_LIST">DIGITMATCH</field>
                <next>
                  <block type="trade_definition_restartbuysell" id="restart_def">
                    <field name="TIME_MACHINE_ENABLED">FALSE</field>
                    <next>
                      <block type="trade_definition_restartonerror" id="onerror_def">
                        <field name="RESTARTONERROR">TRUE</field>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <statement name="INITIALIZATION">
      <block type="notify" id="start_notify">
        <field name="NOTIFICATION_TYPE">info</field>
        <field name="NOTIFICATION_SOUND">announcement</field>
        <value name="MESSAGE">
          <block type="text" id="start_msg">
            <field name="TEXT">ELISY254 START - MATCHES ONLY</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="init_stake">
            <field name="VAR" id="Stake">Stake</field>
            <value name="VALUE">
              <block type="math_number" id="stake_num">
                <field name="NUM">1</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="init_initial">
                <field name="VAR" id="InitialStake">Initial Stake</field>
                <value name="VALUE">
                  <block type="math_number" id="initial_num">
                    <field name="NUM">1</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="init_reduction">
                    <field name="VAR" id="Martingale">Martingale Reduction</field>
                    <value name="VALUE">
                      <block type="math_number" id="reduction_num">
                        <field name="NUM">0.25</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="init_target">
                        <field name="VAR" id="TargetProfit">Target Profit</field>
                        <value name="VALUE">
                          <block type="math_number" id="target_num">
                            <field name="NUM">10</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="init_stop">
                            <field name="VAR" id="StopLoss">Stop Loss</field>
                            <value name="VALUE">
                              <block type="math_number" id="stop_num">
                                <field name="NUM">50</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="init_profit">
                                <field name="VAR" id="TotalProfit">Total Profit</field>
                                <value name="VALUE">
                                  <block type="math_number" id="profit_num">
                                    <field name="NUM">0</field>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="options_def">
        <mutation has_first_barrier="true" has_second_barrier="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <block type="math_number" id="duration_num">
            <field name="NUM">1</field>
          </block>
        </value>
        <value name="AMOUNT">
          <block type="variables_get" id="stake_get">
            <field name="VAR" id="Stake">Stake</field>
          </block>
        </value>
        <value name="BARRIER">
          <block type="math_number" id="match_digit">
            <field name="NUM">5</field>
          </block>
        </value>
      </block>
    </statement>
  </block>

  <block type="before_purchase" id="before_purchase_def" x="520" y="0">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase" id="purchase_matches">
        <field name="PURCHASE_LIST">DIGITMATCH</field>
      </block>
    </statement>
  </block>

  <block type="after_purchase" id="after_purchase_def" x="520" y="260">
    <statement name="AFTERPURCHASE_STACK">
      <block type="variables_set" id="update_profit">
        <field name="VAR" id="TotalProfit">Total Profit</field>
        <value name="VALUE">
          <block type="math_arithmetic" id="add_profit">
            <field name="OP">ADD</field>
            <value name="A">
              <block type="variables_get" id="profit_get">
                <field name="VAR" id="TotalProfit">Total Profit</field>
              </block>
            </value>
            <value name="B">
              <block type="read_details" id="read_profit">
                <field name="DETAIL_INDEX">4</field>
              </block>
            </value>
          </block>
        </value>
        <next>
          <block type="controls_if" id="outcome_check">
            <mutation else="1"></mutation>
            <value name="IF0">
              <block type="contract_check_result" id="win_check">
                <field name="CHECK_RESULT">win</field>
              </block>
            </value>
            <statement name="DO0">
              <block type="notify" id="win_notify">
                <field name="NOTIFICATION_TYPE">success</field>
                <field name="NOTIFICATION_SOUND">earned-money</field>
                <value name="MESSAGE">
                  <block type="text" id="win_message">
                    <field name="TEXT">ELISY254 MATCH WIN!</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="reset_stake">
                    <field name="VAR" id="Stake">Stake</field>
                    <value name="VALUE">
                      <block type="variables_get" id="base_stake_get">
                        <field name="VAR" id="InitialStake">Initial Stake</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="notify" id="loss_notify">
                <field name="NOTIFICATION_TYPE">error</field>
                <field name="NOTIFICATION_SOUND">severe-error</field>
                <value name="MESSAGE">
                  <block type="text" id="loss_message">
                    <field name="TEXT">ELISY254 MATCH LOSS - REDUCING NEXT STAKE</field>
                  </block>
                </value>
                <next>
                  <block type="controls_if" id="minimum_stake_check">
                    <mutation else="1"></mutation>
                    <value name="IF0">
                      <block type="logic_compare" id="stake_above_reduction">
                        <field name="OP">GT</field>
                        <value name="A">
                          <block type="variables_get" id="stake_current">
                            <field name="VAR" id="Stake">Stake</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="variables_get" id="reduction_get">
                            <field name="VAR" id="Martingale">Martingale Reduction</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="variables_set" id="reduce_stake">
                        <field name="VAR" id="Stake">Stake</field>
                        <value name="VALUE">
                          <block type="math_arithmetic" id="subtract_stake">
                            <field name="OP">MINUS</field>
                            <value name="A">
                              <block type="variables_get" id="stake_before_subtract">
                                <field name="VAR" id="Stake">Stake</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="variables_get" id="reduction_before_subtract">
                                <field name="VAR" id="Martingale">Martingale Reduction</field>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </statement>
                    <statement name="ELSE">
                      <block type="variables_set" id="floor_stake">
                        <field name="VAR" id="Stake">Stake</field>
                        <value name="VALUE">
                          <block type="math_number" id="minimum_stake">
                            <field name="NUM">0.35</field>
                          </block>
                        </value>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </statement>
            <next>
              <block type="controls_if" id="limits_check">
                <mutation elseif="1" else="1"></mutation>
                <value name="IF0">
                  <block type="logic_compare" id="target_compare">
                    <field name="OP">GTE</field>
                    <value name="A">
                      <block type="variables_get" id="profit_for_target">
                        <field name="VAR" id="TotalProfit">Total Profit</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="variables_get" id="target_get">
                        <field name="VAR" id="TargetProfit">Target Profit</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="notify" id="target_notify">
                    <field name="NOTIFICATION_TYPE">success</field>
                    <field name="NOTIFICATION_SOUND">job-done</field>
                    <value name="MESSAGE">
                      <block type="text" id="target_message">
                        <field name="TEXT">ELISY254 TARGET HIT! STOPPING</field>
                      </block>
                    </value>
                  </block>
                </statement>
                <value name="IF1">
                  <block type="logic_compare" id="stop_compare">
                    <field name="OP">LTE</field>
                    <value name="A">
                      <block type="variables_get" id="profit_for_stop">
                        <field name="VAR" id="TotalProfit">Total Profit</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_single" id="negative_stop">
                        <field name="OP">NEG</field>
                        <value name="NUM">
                          <block type="variables_get" id="stop_get">
                            <field name="VAR" id="StopLoss">Stop Loss</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO1">
                  <block type="notify" id="stoploss_notify">
                    <field name="NOTIFICATION_TYPE">error</field>
                    <field name="NOTIFICATION_SOUND">severe-error</field>
                    <value name="MESSAGE">
                      <block type="text" id="stoploss_message">
                        <field name="TEXT">ELISY254 STOP LOSS HIT!</field>
                      </block>
                    </value>
                  </block>
                </statement>
                <statement name="ELSE">
                  <block type="trade_again" id="trade_again_block"></block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
