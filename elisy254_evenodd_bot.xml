<xml xmlns="http://www.w3.org/1999/xhtml" collection="false">
  <variables>
    <variable type="" id="Stake">Stake</variable>
    <variable type="" id="InitialStake">Initial Stake</variable>
    <variable type="" id="Martingale">Martingale Multiplier</variable>
    <variable type="" id="TargetProfit">Target Profit</variable>
    <variable type="" id="StopLoss">Stop Loss</variable>
    <variable type="" id="TotalProfit">Total Profit</variable>
  </variables>

  <!-- BLOCK 1: SETUP -->
  <block type="trade_definition" id="trade_def" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="market_def">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">R_100</field>
        <next>
          <block type="trade_definition_tradetype" id="tradetype_def">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">evenodd</field>
            <next>
              <block type="trade_definition_contracttype" id="contracttype_def">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="interval_def">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuystat" id="restart_def">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="onerror_def">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="notify" id="start_notify">
        <field name="NOTIFICATION_TYPE">info</field>
        <field name="NOTIFICATION_SOUND">announcement</field>
        <value name="MESSAGE"><block type="text" id="start_txt"><field name="TEXT">ELISY254 START</field></block></value>
        <next>
          <block type="variables_set" id="init_stake">
            <field name="VAR" id="Stake">Stake</field>
            <value name="VALUE"><block type="math_number" id="n_stk"><field name="NUM">1</field></block></value>
            <next>
              <block type="variables_set" id="init_init_stk">
                <field name="VAR" id="InitialStake">Initial Stake</field>
                <value name="VALUE"><block type="math_number" id="n_i_stk"><field name="NUM">1</field></block></value>
                <next>
                  <block type="variables_set" id="init_mart">
                    <field name="VAR" id="Martingale">Martingale Multiplier</field>
                    <value name="VALUE"><block type="math_number" id="n_m"><field name="NUM">2.1</field></block></value>
                    <next>
                      <block type="variables_set" id="init_tp">
                        <field name="VAR" id="TargetProfit">Target Profit</field>
                        <value name="VALUE"><block type="math_number" id="n_tp"><field name="NUM">10</field></block></value>
                        <next>
                          <block type="variables_set" id="init_sl">
                            <field name="VAR" id="StopLoss">Stop Loss</field>
                            <value name="VALUE"><block type="math_number" id="n_sl"><field name="NUM">50</field></block></value>
                            <next>
                              <block type="variables_set" id="init_tot">
                                <field name="VAR" id="TotalProfit">Total Profit</field>
                                <value name="VALUE"><block type="math_number" id="n_tot"><field name="NUM">0</field></block></value>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="options_def">
        <mutation has_first_barrier="false" has_second_barrier="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION"><block type="math_number" id="dur_num"><field name="NUM">1</field></block></value>
        <value name="AMOUNT"><block type="variables_get" id="get_stk"><field name="VAR" id="Stake">Stake</field></block></value>
      </block>
    </statement>
  </block>

  <!-- BLOCK 2: ENTRY SIGNAL -->
  <block type="before_purchase" id="before_purchase_def" x="520" y="0">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="controls_if" id="chk_parity">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="math_number_property" id="chk_even">
            <mutation divisor_input="false"></mutation>
            <field name="PROPERTY">EVEN</field>
            <value name="NUMBER_TO_CHECK"><block type="last_digit" id="g_digit"></block></value>
          </block>
        </value>
        <statement name="DO0">
          <block type="purchase" id="buy_even"><field name="PURCHASE_LIST">DIGITEVEN</field></block>
        </statement>
        <statement name="ELSE">
          <block type="purchase" id="buy_odd"><field name="PURCHASE_LIST">DIGITODD</field></block>
        </statement>
      </block>
    </statement>
  </block>

  <!-- BLOCK 3: AFTER PURCHASE & RECOVERY -->
  <block type="after_purchase" id="after_purchase_def" x="520" y="200">
    <statement name="AFTERPURCHASE_STACK">
      <block type="variables_set" id="upd_p">
        <field name="VAR" id="TotalProfit">Total Profit</field>
        <value name="VALUE">
          <block type="math_arithmetic" id="add_p">
            <field name="OP">ADD</field>
            <value name="A"><block type="variables_get" id="g_tp"><field name="VAR" id="TotalProfit">Total Profit</field></block></value>
            <value name="B"><block type="read_details" id="r_pay"><field name="DETAIL_INDEX">4</field></block></value>
          </block>
        </value>
        <next>
          <block type="controls_if" id="chk_res">
            <mutation else="1"></mutation>
            <value name="IF0"><block type="contract_check_result" id="c_win"><field name="CHECK_RESULT">win</field></block></value>
            <statement name="DO0">
              <block type="notify" id="n_win">
                <field name="NOTIFICATION_TYPE">success</field>
                <field name="NOTIFICATION_SOUND">earned-money</field>
                <value name="MESSAGE"><block type="text" id="t_w"><field name="TEXT">Elisy254 EVEN/ODD WIN!</field></block></value>
                <next>
                  <block type="variables_set" id="r_stk">
                    <field name="VAR" id="Stake">Stake</field>
                    <value name="VALUE"><block type="variables_get" id="g_init"><field name="VAR" id="InitialStake">Initial Stake</field></block></value>
                  </block>
                </next>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="notify" id="n_loss">
                <field name="NOTIFICATION_TYPE">error</field>
                <field name="NOTIFICATION_SOUND">severe-error</field>
                <value name="MESSAGE"><block type="text" id="t_l"><field name="TEXT">Elisy254 LOSS! Recovering 2.1x...</field></block></value>
                <next>
                  <block type="variables_set" id="m_stk">
                    <field name="VAR" id="Stake">Stake</field>
                    <value name="VALUE">
                      <block type="math_arithmetic" id="mult_stk">
                        <field name="OP">MULTIPLY</field>
                        <value name="A"><block type="variables_get" id="g_curr"><field name="VAR" id="Stake">Stake</field></block></value>
                        <value name="B"><block type="variables_get" id="g_mart"><field name="VAR" id="Martingale">Martingale Multiplier</field></block></value>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </statement>
            <next>
              <block type="controls_if" id="chk_limits">
                <mutation elseif="1" else="1"></mutation>
                <value name="IF0">
                  <block type="logic_compare" id="c_tp">
                    <field name="OP">GTE</field>
                    <value name="A"><block type="variables_get" id="g_tot_p"><field name="VAR" id="TotalProfit">Total Profit</field></block></value>
                    <value name="B"><block type="variables_get" id="g_tar_p"><field name="VAR" id="TargetProfit">Target Profit</field></block></value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="notify" id="n_tp">
                    <field name="NOTIFICATION_TYPE">success</field>
                    <field name="NOTIFICATION_SOUND">job-done</field>
                    <value name="MESSAGE"><block type="text" id="t_tp"><field name="TEXT">ELISY254 TARGET HIT! UPDATE CODES</field></block></value>
                  </block>
                </statement>
                <value name="IF1">
                  <block type="logic_compare" id="c_sl">
                    <field name="OP">LTE</field>
                    <value name="A"><block type="variables_get" id="g_tot_sl"><field name="VAR" id="TotalProfit">Total Profit</field></block></value>
                    <value name="B"><block type="math_single" id="n_sl"><field name="OP">NEG</field><value name="NUM"><block type="variables_get" id="g_sl"><field name="VAR" id="StopLoss">Stop Loss</field></block></value></block></value>
                  </block>
                </value>
                <statement name="DO1">
                  <block type="notify" id="n_sl">
                    <field name="NOTIFICATION_TYPE">error</field>
                    <field name="NOTIFICATION_SOUND">severe-error</field>
                    <value name="MESSAGE"><block type="text" id="t_sl"><field name="TEXT">Elisy254 2026 STOP LOSS HIT!</field></block></value>
                  </block>
                </statement>
                <statement name="ELSE">
                  <block type="trade_again" id="trd_ag2"></block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
