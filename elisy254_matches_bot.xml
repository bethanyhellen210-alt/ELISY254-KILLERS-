<xml xmlns="http://www.w3.org/1999/xhtml" collection="false">
  <variables>
    <variable id="v_stake">stake</variable>
    <variable id="v_initial">initial_stake</variable>
    <variable id="v_martingale">martingale</variable>
    <variable id="v_target">target_profit</variable>
    <variable id="v_stop">stop_loss</variable>
    <variable id="v_total">total_profit</variable>
  </variables>

  <!-- BLOCK 1: TRADE DEFINITION & VARIABLES -->
  <block type="trade_definition" id="trade_def" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="market">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ10V</field>
        <next>
          <block type="trade_definition_tradetype" id="tradetype">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">matchesdiffers</field>
            <next>
              <block type="trade_definition_contracttype" id="contracttype">
                <field name="TYPE_LIST">DIGITMATCH</field>
                <next>
                  <block type="trade_definition_candleinterval" id="candleinterval">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuystat" id="restartbuystat">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="restartonerror">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="init_s">
        <field name="VAR" id="v_stake">stake</field>
        <value name="VALUE">
          <block type="math_number" id="num_s">
            <field name="NUM">1</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="init_i">
            <field name="VAR" id="v_initial">initial_stake</field>
            <value name="VALUE">
              <block type="math_number" id="num_i">
                <field name="NUM">1</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="init_m">
                <field name="VAR" id="v_martingale">martingale</field>
                <value name="VALUE">
                  <block type="math_number" id="num_m">
                    <field name="NUM">1.15</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="init_tp">
                    <field name="VAR" id="v_target">target_profit</field>
                    <value name="VALUE">
                      <block type="math_number" id="num_tp">
                        <field name="NUM">10</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="init_sl">
                        <field name="VAR" id="v_stop">stop_loss</field>
                        <value name="VALUE">
                          <block type="math_number" id="num_stop">
                            <field name="NUM">50</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="init_tot">
                            <field name="VAR" id="v_total">total_profit</field>
                            <value name="VALUE">
                              <block type="math_number" id="num_tot">
                                <field name="NUM">0</field>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="trade_options">
        <mutation has_first_barrier="true" has_second_barrier="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <block type="math_number" id="duration">
            <field name="NUM">1</field>
          </block>
        </value>
        <value name="AMOUNT">
          <block type="variables_get" id="get_stake">
            <field name="VAR" id="v_stake">stake</field>
          </block>
        </value>
        <value name="BARRIER">
          <block type="last_digit" id="get_digit_barrier"></block>
        </value>
      </block>
    </statement>
  </block>

  <!-- BLOCK 2: PURCHASE ENTRY -->
  <block type="before_purchase" id="before_purchase" x="0" y="550">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="purchase" id="purchase">
        <field name="PURCHASE_LIST">DIGITMATCH</field>
      </block>
    </statement>
  </block>

  <!-- BLOCK 3: AFTER PURCHASE & MARTINGALE LOGIC -->
  <block type="after_purchase" id="after_purchase" x="0" y="700">
    <statement name="AFTERPURCHASE_STACK">
      <block type="variables_set" id="update_profit">
        <field name="VAR" id="v_total">total_profit</field>
        <value name="VALUE">
          <block type="math_arithmetic" id="add_profit">
            <field name="OP">ADD</field>
            <value name="A">
              <block type="variables_get" id="get_total">
                <field name="VAR" id="v_total">total_profit</field>
              </block>
            </value>
            <value name="B">
              <block type="read_details" id="read_payout">
                <field name="DETAIL_INDEX">4</field>
              </block>
            </value>
          </block>
        </value>
        <next>
          <block type="controls_if" id="check_win_loss">
            <mutation else="1"></mutation>
            <value name="IF0">
              <block type="contract_check_result" id="check_result">
                <field name="CHECK_RESULT">win</field>
              </block>
            </value>
            <!-- ON WIN: RESET STAKE -->
            <statement name="DO0">
              <block type="variables_set" id="reset_stake">
                <field name="VAR" id="v_stake">stake</field>
                <value name="VALUE">
                  <block type="variables_get" id="get_initial">
                    <field name="VAR" id="v_initial">initial_stake</field>
                  </block>
                </value>
              </block>
            </statement>
            <!-- ON LOSS: MULTIPLY STAKE -->
            <statement name="ELSE">
              <block type="variables_set" id="apply_martingale">
                <field name="VAR" id="v_stake">stake</field>
                <value name="VALUE">
                  <block type="math_arithmetic" id="mult_stake">
                    <field name="OP">MULTIPLY</field>
                    <value name="A">
                      <block type="variables_get" id="get_curr_stake">
                        <field name="VAR" id="v_stake">stake</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="variables_get" id="get_mart">
                        <field name="VAR" id="v_martingale">martingale</field>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </statement>
            <next>
              <!-- CHECK TARGET PROFIT & STOP LOSS -->
              <block type="controls_if" id="check_limits">
                <mutation elseif="1" else="1"></mutation>
                <value name="IF0">
                  <block type="logic_compare" id="cmp_tp">
                    <field name="OP">GTE</field>
                    <value name="A">
                      <block type="variables_get" id="chk_tp_tot">
                        <field name="VAR" id="v_total">total_profit</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="variables_get" id="chk_tp_val">
                        <field name="VAR" id="v_target">target_profit</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <!-- STOP EXECUTION ON TARGET PROFIT -->
                </statement>
                <value name="IF1">
                  <block type="logic_compare" id="cmp_sl">
                    <field name="OP">LTE</field>
                    <value name="A">
                      <block type="variables_get" id="chk_sl_tot">
                        <field name="VAR" id="v_total">total_profit</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_single" id="negate_sl">
                        <field name="OP">NEG</field>
                        <value name="NUM">
                          <block type="variables_get" id="chk_sl_val">
                            <field name="VAR" id="v_stop">stop_loss</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO1">
                  <!-- STOP EXECUTION ON STOP LOSS -->
                </statement>
                <statement name="ELSE">
                  <block type="trade_again" id="trade_again"></block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
